def translate(mrna, table):
    mrna = mrna.upper()
    output = ''
    for i in range(0, len(mrna), 3):
        output += table[mrna[i:i+3]]
    return output

def valid_mrna_check(string):
    valid_nucleotides = {"a", "u", "g", "c"}
    for char in str(string):
        if char not in valid_nucleotides:
            return False
    '''if string != valid_nucleotides:
        return False'''
    if not (string.startswith("aug") or string.endswith(("uaa", "uag", "uga"))):
        return False
    if len(string) % 3 != 0:
        return False
    return True

def translate_updated(mrna, codon_table):
    if not valid_mrna_check(mrna):
        return "Error: Not Valid mRNA"
    else:
        return translate(mrna.upper(), codon_table)
print([valid_mrna_check("aggacguag"), valid_mrna_check("auggac")])

aa_seq = translate(orf_mrna, codon_table)
aa_seq
def translate_from_template(template_sequence):
    mrna_seq = transcribe(template_strand)
    mrna_orf = orf(template_sequence)
    aa_seq = translate(mrna_orf, codon_table)
    return aa_seq
print("Do translate_from_template(template_strand) and aa_seq output the same sequence? ", translate_from_template(template_strand) == aa_seq)
print(translate_from_template("ttacgattcatacgtcgactccgtcat")[1:])







